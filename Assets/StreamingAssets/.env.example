# EtheriaVR — configuración del backend
# Copia este archivo como .env para personalizar (opcional; la app usa este ejemplo si no hay .env).
SERVER_IP=3.132.142.210
SERVER_PORT=8000
USE_HTTPS=false

HEALTH_PATH=/health

# true = intenta autodetectar un backend en LAN por UDP (legacy).
# false = usa solo el .env (recomendado con el backend en Docker/nube).
ENABLE_UDP_DISCOVERY=false
